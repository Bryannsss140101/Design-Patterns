# ==========================================
# 1. Carpetas de Construcción (Build)
# ==========================================
# Ignora cualquier carpeta de compilación estándar (build, out, cmake-build-debug, etc.)
build/
out/
cmake-build-*/

# Archivos sueltos de CMake por si compilas accidentalmente en la raíz
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Archivos específicos de usuario o entornos locales
CMakeLists.txt.user
CMakeUserPresets.json

# ==========================================
# 2. Archivos Temporales y Binarios de C++
# ==========================================
# Objetos y librerías estáticas/dinámicas
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Ejecutables finales
*.exe
*.out
*.app

# ==========================================
# 3. Entorno de VS Code
# ==========================================
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
